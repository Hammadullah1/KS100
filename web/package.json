{
  "name": "psx-research-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && node scripts/check-production.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "e2e": "playwright test",
    "contracts": "json2ts -i src/bundle.schema.json -o src/contracts.generated.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.1.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.34.5"
}
